# ============================================================
# Docker Compose 环境变量样例（**不是**后端进程的 .env）
#
# 复制为根目录 .env 后按需修改：cp .env.example .env
#   用途：docker compose up -d 时由 compose 读取并注入容器（见 docker-compose.yml）
#
# ⚠️ 别把它当成 packages/server/.env：
#   后端进程（pnpm dev:server / start:prod）用 ConfigModule 读的是**相对 cwd 的 .env**，
#   即 packages/server/.env，变量清单与本文件不同，且 DB_HOST / DB_PORT 在这里根本不存在
#   —— compose 已在 docker-compose.yml 里把 DB_HOST 硬编码成 mysql 容器名传进容器。
#   直接把这个文件复制成 packages/server/.env 会启动即失败：
#       Error: 环境变量 DB_HOST 未在 .env 文件中配置，请检查！
#   后端的模板请用 packages/server/.env.example。
# ============================================================

# ====== 数据库（MYSQL_* 供 mysql 容器使用） ======
MYSQL_ROOT_PASSWORD=root123456
# 宿主机映射端口；容器内固定 3306。别和 compose 传给后端的 DB_PORT 混用
MYSQL_PORT=3306
DB_NAME=vue3_monorepo
DB_USER=vue3_user
DB_PWD=vue3_pass_2026

# ====== Redis ======
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_2026
# Redis 内存上限。不设的话 --maxmemory-policy 根本不会触发，会一路吃满宿主机内存
REDIS_MAXMEMORY=512mb

# ====== 后端应用 ======
APP_PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# ====== 启动期配置自检的逃生舱 ======
# 默认 false：后端在 NODE_ENV=production/staging 下会校验 JWT / DB / Redis 密钥，
# 发现上面那些公开在仓库里的占位值就打印清单并 exit(1)，拒绝启动。
# 只有本机演示、确实想带着占位密钥跑起来时才改成 true。
# ⚠️ 设为 true 等同于放弃这道防线：JWT 密钥将保持公开值，任何人都能自签管理员令牌。
ALLOW_INSECURE_DEFAULTS=false

# ====== 短信 ======
# production 下默认走真实通道，而阿里云 SDK 尚未接入 → 「发送验证码」固定返回 503，
# 忘记密码 / 短信登录不可用。
# 想让这两个功能先跑通：设为 true，验证码会写到 ./logs/backend，由运维从日志里取
# （不下发给用户、也不回传前端）。正式上线请接入 SDK 并保持 false。
SMS_MOCK=false

# ====== 本地上传目录 ======
# 这两项**必须传**：代码里 path.resolve(cwd, undefined) 会直接抛 TypeError，
# 缺了等价于后端容器起不来。目录已由 Dockerfile.server 预先建好并 chown 给 nestjs。
LOCAL_UPLOAD_BASE_DIR=uploads
LOCAL_STATIC_PREFIX=/uploads

# ====== 前端端口 ======
ADMIN_PORT=8080
APP_H5_PORT=8081

# ====== JWT 密钥（生产环境务必改成随机 32+ 字符） ======
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=please-change-me-access-secret-in-production-32chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=please-change-me-refresh-secret-in-production-32chars-min
JWT_REFRESH_EXPIRES_IN=7d

# ====== CORS 允许的来源（逗号分隔） ======
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# ====== 文件存储（留空 = 本地磁盘；填 oss 才走 OSS） ======
STORAGE_TYPE=

# ====== AI 大模型 ======
# LLM_TYPE 可选 openai / dashscope_qwen / local_ollama，留空等价于 openai。
# 选 openai 或 dashscope_qwen 时必须同时给对应 API Key，否则**服务能起、但每次
# 对话都在调用模型时报鉴权错误**——启动期不校验 key，问题会推迟到用户点击才暴露。
LLM_TYPE=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ====== 阿里云 OSS（STORAGE_TYPE=oss 时必填，其余字段按需） ======
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_CDN_DOMAIN=
OSS_UPLOAD_FOLDER=uploads
