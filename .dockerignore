# ============================================================
# Docker 构建上下文忽略规则 - 减小构建上下文，加快构建速度
# ============================================================

# Git / IDE
.git
.gitignore
.gitattributes
.idea
.vscode
*.swp

# 依赖（容器内重新安装）
node_modules
**/node_modules
.pnpm-store

# 构建产物
dist
**/dist
coverage
**/coverage

# 日志
logs
**/logs
*.log

# 环境变量
.env
.env.local
.env.*.local

# 测试
**/*.spec.ts
**/*.test.ts
**/test
coverage

# 文档
docs
README.md
*.md

# Docker 自身
Dockerfile*
docker-compose*.yml
.dockerignore

# OS 临时文件
.DS_Store
Thumbs.db
tmp