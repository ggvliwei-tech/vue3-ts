# ============================================================
# NestJS 后端镜像 - 多阶段构建
# ============================================================
# 设计要点：
#  1. 多阶段：devDependencies 不进生产镜像
#  2. 依赖目录必须**保持 pnpm workspace 的相对层级**（见下方「关于目录形状」）
#  3. 生产模式：TypeScript 编译产物 dist/ + 只装 production 依赖
#  4. 健康检查：直接复用 /health 端点
#  5. 非 root 用户运行：提高安全性
#
# ----------------------------------------
# 关于目录形状（改这个文件前务必先读）
# ----------------------------------------
# pnpm 不用扁平化的 node_modules，而是在 workspace 根建一个虚拟 store：
#
#   /app/node_modules/.pnpm/<pkg>@<ver>/node_modules/<pkg>   ← 真实文件
#   /app/packages/server/node_modules/<pkg>  →  符号链接指向上面的真实文件
#
# 这些符号链接是**相对的**（pnpm 刻意如此，为了让 node_modules 可搬运）。
# 也就是说 `packages/server/node_modules/@nestjs/common` 里存的是
# `../../../../node_modules/.pnpm/...` 这样一串 `..`，它的含义完全取决于
# 这个链接自己处在第几层目录。
#
# 所以下面 runtime 阶段**不能**把 `packages/server/node_modules` 拷成 `/app/node_modules`
# —— 那样链接会浅三层，`..` 全部越出根目录变成 `/node_modules/.pnpm/...`，
# 镜像能构建成功、但一启动就是 MODULE_NOT_FOUND。必须原样保留
# `packages/server/node_modules` 与 `node_modules/.pnpm` 的相对位置。
#
# 另：这里没有 `@project/shared`。server 的源码从不 import 它（只有 admin / app 在用），
# 早先版本为它单独建了一个 shared-builder 阶段并往 node_modules/@project/shared 里
# 塞文件，那既指错了地方（符号链接指向 packages/shared，不是 node_modules 下），
# 也白装了一整套前端依赖。依赖已从 packages/server/package.json 移除。
# ============================================================

# -------- 阶段 1：编译 server --------
# 需要 devDependencies（nest build / typescript 都在 dev 里），故不带 --prod
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate
WORKDIR /app

# 不要写成 `.npmrc*`：COPY 的通配符必须至少匹配一个文件，仓库里没有 .npmrc 时
# 构建会直接报 "no source files were specified"（COPY 没有「存在才拷贝」的语义）。
# 将来确实需要 .npmrc 时再把这行改回来。
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/server ./packages/server

# --frozen-lockfile：锁文件与 package.json 不一致时直接失败，避免镜像里的依赖
# 与开发机悄悄漂移。工作区里其余包（admin/app/shared）不在构建上下文里也没关系 ——
# pnpm 只校验它实际看到的项目。
RUN pnpm install --frozen-lockfile

WORKDIR /app/packages/server
RUN pnpm build

# -------- 阶段 2：只装生产依赖 --------
# 单独开一个阶段而不是在阶段 1 上 `pnpm prune --prod`：
# prune 在 workspace 下会去动共享的虚拟 store，边界不清晰；这里从零装一份
# 干净的生产依赖，`.pnpm` 里只有运行时真正需要的包。
FROM node:22-alpine AS prod-deps
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
# 只需要 package.json（不拷贝源码）：pnpm 靠它解析依赖清单
COPY packages/server/package.json ./packages/server/package.json

RUN pnpm install --frozen-lockfile --prod

# -------- 阶段 3：运行镜像 --------
FROM node:22-alpine AS runtime
# 安装 wget（用于 HEALTHCHECK）和 tini（PID 1 信号转发，实现优雅关闭）
#
# Alpine 官方源在部分国内网络下会 TLS 握手失败（apk 报 "TLS: unspecified error"，
# 但同一个构建里 pnpm install 访问 npmjs 却正常）。这里允许用 build arg 切换源，
# docker-compose.yml 默认传阿里云镜像；部署在海外时可覆盖回官方源：
#   ALPINE_MIRROR=https://dl-cdn.alpinelinux.org docker compose build backend
ARG ALPINE_MIRROR=https://dl-cdn.alpinelinux.org
RUN if [ "$ALPINE_MIRROR" != "https://dl-cdn.alpinelinux.org" ]; then \
        sed -i "s#https://dl-cdn.alpinelinux.org#${ALPINE_MIRROR}#g" /etc/apk/repositories; \
    fi \
    && apk add --no-cache wget tini

# 创建非 root 用户
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 -G nodejs

WORKDIR /app

# 设置环境变量默认值（运行时可通过 docker run -e 或 docker-compose 覆盖）
ENV NODE_ENV=production \
    APP_PORT=3000 \
    APP_HOST=0.0.0.0 \
    LOG_LEVEL=info

# ========== 运行时依赖（两处，缺一不可，相对位置不能改） ==========
# 1) workspace 根的虚拟 store：所有第三方包的真实文件都在这里
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules
# 2) 本包的 node_modules：一堆指向上面 .pnpm 的相对符号链接
COPY --from=prod-deps --chown=nestjs:nodejs /app/packages/server/node_modules ./packages/server/node_modules

# ========== 构建产物 ==========
COPY --from=builder --chown=nestjs:nodejs /app/packages/server/dist ./packages/server/dist
COPY --from=builder --chown=nestjs:nodejs /app/packages/server/package.json ./packages/server/package.json

# 日志目录（与 winston.config.ts 中 LOG_DIR = process.cwd()/logs 对齐）
# 上传目录必须在这里预先建好并改属主：/app 是 WORKDIR 由 root 创建的（755），
# 非 root 的 nestjs 用户无法在其中 mkdir；而 LocalStorage 构造函数会执行
# fs.mkdirSync(baseDir)，权限不足抛 EACCES，同样是启动即失败。
RUN mkdir -p /app/logs /app/uploads && chown -R nestjs:nodejs /app/logs /app/uploads

USER nestjs

EXPOSE 3000

# HEALTHCHECK：每 30s 探测一次 /health，连续 3 次失败标记为 unhealthy
# 生产环境 K8s 会用 readinessProbe，此 HEALTHCHECK 主要给 Docker standalone 用
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/health || exit 1

# tini 作为 PID 1，正确转发 SIGTERM/SIGINT 给 Node 进程，配合 nestjs 的 enableShutdownHooks 实现优雅关闭
ENTRYPOINT ["/sbin/tini", "--"]

# 入口保持在工作区根（而不是 cd 进 packages/server）：
# winston 的日志目录与 LocalStorage 的上传目录都基于 process.cwd() 解析，
# 而 docker-compose 挂的是 /app/logs 与 /app/uploads —— cwd 一变，挂载就落空。
CMD ["node", "packages/server/dist/main.js"]
