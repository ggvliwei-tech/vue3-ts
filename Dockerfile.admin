# ============================================================
# Admin 前端镜像 - Vue 3 + Nginx
# ============================================================
# 设计要点：
#  1. 多阶段：Node 构建 → Nginx 托管静态产物
#  2. SPA 路由：nginx.conf 中 try_files 转发到 index.html
#  3. API 反向代理：/api/ 和 /socket.io/ 转发到 backend 服务
#  4. 静态资源缓存 + Gzip 压缩
# ============================================================

# -------- 阶段 1：构建静态产物 --------
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc* ./
COPY packages/shared ./packages/shared
COPY packages/admin ./packages/admin

# 先 build shared（admin 依赖）
WORKDIR /app/packages/shared
RUN pnpm install --frozen-lockfile && pnpm build

# 再 build admin
WORKDIR /app/packages/admin

# 后端地址（构建期注入）。留空 = 走相对路径，由本镜像的 nginx 把 /api/ 反代到 backend。
# 需要前端直连别的域名时：docker compose build --build-arg VITE_API_BASE_URL=https://api.xxx.com
# 注：Vite 里 process.env 的优先级高于 .env.production（见 vite 的 loadEnv 实现），
#     所以这个 ENV 一定能覆盖仓库里的 packages/admin/.env.production。
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm install --frozen-lockfile && pnpm build

# -------- 阶段 2：Nginx 托管 --------
FROM nginx:1.27-alpine AS runtime

# 删除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 拷贝自定义 nginx 配置
COPY deploy/nginx/admin.conf /etc/nginx/conf.d/admin.conf

# 拷贝构建产物到 nginx 静态目录
COPY --from=builder /app/packages/admin/dist /usr/share/nginx/html

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]