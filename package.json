{
  "name": "vue3-monorepo",
  "version": "1.0.0",
  "description": "Vue 3 Monorepo with pnpm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "dev:app": "pnpm --filter app dev",
    "dev:server": "pnpm --filter @project/server start:dev",
    "dev:all": "pnpm -r --parallel dev",
    "dev:full": "concurrently \"pnpm dev:server\" \"pnpm dev:all\"",
    "build:shared": "pnpm --filter @project/shared build",
    "build:server": "pnpm --filter @project/server build",
    "build:admin": "pnpm --filter admin build",
    "build:app": "pnpm --filter app build",
    "build:all": "pnpm build:shared && pnpm -r --filter=admin --filter=app build",
    "preview:admin": "pnpm --filter admin preview",
    "preview:app": "pnpm --filter app preview",
    "start:server": "pnpm --filter @project/server start:prod",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check --parallel",
    "clean": "pnpm -r clean && rimraf -rf node_modules",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @project/server test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.3"
}
