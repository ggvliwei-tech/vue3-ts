node_modules

# Build output of all packages (regenerated on build)
**/dist/

# Auto-generated type declarations (regenerated on build/dev)
**/auto-imports.d.ts
**/components.d.ts

# ============================================================
# 本地环境变量：含数据库口令 / JWT 密钥 / 第三方 API Key，绝不入库
# 不带斜杠的模式匹配任意层级，因此 packages/server/.env 也被覆盖。
# 模板文件（.env.example、前端 .env.development / .env.production，
# 仅含公开的 VITE_ 变量）是有意入库的，不受这些规则影响。
# 新增环境变量请同步更新 .env.example，而不是提交真实 .env
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
# TLS 证书私钥：**绝不入库**
# 生产部署把 fullchain.pem / privkey.pem 放在 deploy/certs/ 下，
# 由 docker-compose 以只读方式挂进 nginx 容器。
# 私钥一旦提交，等同于把域名的身份交出去 —— 任何人都能用它伪造成你的站点。
# 之前仓库里没有任何 pem/cert/key 规则，照文档放证书有误提交的风险，
# 这里显式挡一道。
# ============================================================
deploy/certs/
*.pem
*.key
*.p12
*.pfx

# certbot webroot（http-01 校验用的临时目录，内容是一次性的）
deploy/certbot-www/

# 运行时产物：日志与本地存储的上传文件
logs/
**/logs/
uploads/
**/uploads/
*.log

# ============================================================
# IDE 本地配置：每台机器各不相同（绝对路径、索引、运行配置），
# 入库只会让别人的 IDE 报错、并在每次拉取时产生无意义冲突。
# .idea/ 下原有的 4 个文件已从版本库移除。
# ============================================================
.idea/
.vscode/
*.iml
