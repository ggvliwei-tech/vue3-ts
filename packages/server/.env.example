# ============================================================
# 后端进程环境变量模板（NestJS Server）
#
# 用法：复制为同目录下的 .env
#     cp packages/server/.env.example packages/server/.env
#
# 本机私有覆盖请另建 packages/server/.env.local（已 gitignore），不要改本文件：
# ConfigModule 的 envFilePath 是 ['.env.local', '.env']，同名变量以前者为准。
# 典型用途 —— 宿主机后端与 compose 后端同时运行（推荐调试方式）：
#     APP_PORT=3001          # 避开 compose 发布的 127.0.0.1:3000
# 然后前端 packages/admin/.env.local 或 packages/app/.env.local 写：
#     VITE_API_TARGET=http://127.0.0.1:3001
# 只想用 Docker 里的后端时，本地后端不必启动，前端留空即默认代理 127.0.0.1:3000。
#
# 为什么必须是 packages/server/.env、而不是仓库根目录的 .env 或根 .env.example：
#   ConfigModule 按**进程工作目录**解析相对路径 ".env"，后端进程的 cwd 是
#   packages/server（见 package.json 的 start:dev / start:prod），所以只有这个
#   位置的文件会被读到。根目录的 .env.example 是给 docker compose 用的，
#   两者变量清单不同（那边没有 DB_HOST，也没有下面这几项）。
#
# 表中标注【必填】的变量由 configuration.ts 的 getEnv() / ConfigService.getOrThrow()
# 强制校验：缺失时进程**启动即抛错**，不会静默降级。
#
# 另有一道生产环境自检（config/production-env.util.ts）：当 NODE_ENV=production
# 或 staging 时，若密钥仍是本文件里的占位值（或短于 32 位、access/refresh 相同、
# Redis 密码为空），进程会**拒绝启动**并在控制台列出全部问题。
# 本机演示确需沿用占位值时，追加一行 ALLOW_INSECURE_DEFAULTS=true 跳过。
# ============================================================

NODE_ENV=development
# 置 true 可跳过生产环境密钥自检（仅限本机演示 / 隔离内网，对外部署务必去掉）
# ALLOW_INSECURE_DEFAULTS=true

# ====== 应用 ======
APP_PORT=3000
# 监听地址，0.0.0.0 表示允许局域网访问
APP_HOST=0.0.0.0
# 仅用于 /health 响应里回显的版本号，不填则该字段为空
APP_VERSION=1.0.0
# 日志级别：error / warn / info / debug / verbose
LOG_LEVEL=info

# ====== MySQL【必填：DB_HOST/DB_PORT/DB_USER/DB_PWD/DB_NAME】 ======
# 本机直跑用 127.0.0.1；容器内跑用 compose 注入的 mysql 服务名。
# 若 MySQL 用 compose 起的容器，这里要填**宿主机映射端口**（根 .env 的
# MYSQL_PORT；默认 3306，宿主机已有 MySQL 时通常改成 3307），不是容器内的 3306。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vue3_user
DB_PWD=vue3_pass_2026
DB_NAME=vue3_monorepo
# 连接池上限，默认 20
DB_POOL_SIZE=20

# ====== Redis ======
# 会话（refresh token、黑名单）全部存在 Redis 里，Redis 不可用等于无法登录。
# 三项都有代码默认值（127.0.0.1 / 6379 / 空密码），本机默认安装时可以不写。
# 若 Redis 用 compose 起的容器，端口要填宿主机映射端口（根 .env 的 REDIS_PORT，
# 常见为 6380），并且必须与容器的 requirepass 密码一致。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ====== JWT【必填：两个 SECRET】 ======
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 两个密钥必须不同：refresh token 用 JWT_REFRESH_SECRET 单独签名，混用会让
# access token 能被当作 refresh token 提交。
JWT_ACCESS_SECRET=please-change-me-access-secret-in-production-32chars-min
# 默认 30m。session.service.ts 的黑名单 TTL 直接由本值推导，改小等于缩短踢人效果覆盖范围
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=please-change-me-refresh-secret-in-production-32chars-min
JWT_REFRESH_EXPIRES_IN=7d

# ====== CORS【必填】 ======
# 逗号分隔，逐项 trim。带 Cookie 的跨域请求要靠它放行，漏掉前端端口会登录成功但刷新失败。
# 端口与各包 vite.config.ts 的 server.port 对齐：app=5173、admin=5175。
# 注意生产环境没有兜底（main.ts 的局域网正则仅在 NODE_ENV !== production 时生效），
# 漏一个端口就是该前端全体跨域被拒，务必逐个核对。
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# ====== 文件存储【必填：LOCAL_UPLOAD_BASE_DIR / LOCAL_STATIC_PREFIX】 ======
# 这两项**没有代码兜底**：缺失时 file.module.ts 会执行
# path.resolve(process.cwd(), undefined) 直接抛 TypeError，进程起不来。
# STORAGE_TYPE=oss 时才走 OSS，其余值（含留空）都走本地磁盘。
STORAGE_TYPE=local
# 相对 process.cwd() 的路径，即 packages/server/uploads
LOCAL_UPLOAD_BASE_DIR=uploads
# 静态资源的 URL 前缀，必须与前端拼接图片地址时用的前缀一致
LOCAL_STATIC_PREFIX=/uploads

# ====== 阿里云 OSS（STORAGE_TYPE=oss 时必填） ======
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_CDN_DOMAIN=
OSS_UPLOAD_FOLDER=uploads

# ====== AI 大模型 ======
# LLM_TYPE 可选 openai / dashscope_qwen / local_ollama，留空等价于 openai。
# 与 JWT 不同，这里**启动期不校验 API Key**：选错模型或 key 为空时服务照常启动，
# 直到第一次对话才在调用处报鉴权错误，排查时容易误判成后端 bug。
LLM_TYPE=dashscope_qwen
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# 知识库（RAG）的 embedding 模型。必须显式指定：不填时 OpenAIEmbeddings
# 会回落到 OpenAI 的 text-embedding-ada-002，DashScope 兼容端点不认该模型名，
# 表现为上传 PDF 时 400 / Missing credentials。
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ====== RAG 向量库（仅 AI 知识库功能需要） ======
# 本文件是**宿主机直跑后端**（pnpm dev:server / pnpm start:dev）用的，
# 所以这里填宿主机视角的地址：端口 8001 是 docker compose 把 chroma 容器
# 映射到宿主机的端口（见根 .env.example 的 CHROMA_HTTP_PORT）。
#
# 若 backend 也跑在容器里（docker compose），compose 会直接注入
# CHROMA_HOST=chroma / CHROMA_PORT=8000，不会读本文件，改这里没有效果。
#
# ⚠️ 不要用 8000 —— 宿主机的 LODOP 打印服务占着这个端口，
# 命中它会让 chromadb 客户端拿到 HTML 而报
# `Cannot read properties of undefined (reading 'embedding_function')`。
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ====== 审计 ======
# 清理任务保留天数，默认 90
AUDIT_RETENTION_DAYS=90

# ====== 短信 ======
# 取值含义随 NODE_ENV 而变，两种环境的默认行为是反的：
#   development          —— 默认走 mock；写 false 才真正发短信
#   production / staging —— 默认真正发短信；只有严格写 true 才走 mock
#
# 注意：真实短信通道（阿里云 SDK）尚未接入，sendViaAliyun 仍是占位实现。
# 因此在 production 下保持 false，调用「发送验证码」会返回 503。
# 想让忘记密码 / 短信登录先跑通，就设成 true —— 验证码只写服务端日志，
# 由运维从 logs 里取；它不会下发给用户，也不会回传前端。
SMS_MOCK=true
