# 服务端口
APP_PORT=3000

# MySQL配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PWD=liwei
DB_NAME=nest_db

# JWT配置
# JWT Access Token（业务鉴权，短时效）
JWT_ACCESS_SECRET=AccessSecret2026@nest
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh Token（刷新用，长时效）
JWT_REFRESH_SECRET=RefreshSecret2026@nest
JWT_REFRESH_EXPIRES_IN=7d

## 文件访问地址
APP_BASE_URL=http://localhost:3000
## 阿里云 OSS 配置（选填，留空则降级为本地存储）
## OSS_REGION=
## OSS_ACCESS_KEY_ID=
## OSS_ACCESS_KEY_SECRET=
## OSS_BUCKET=
## OSS_BASE_URL=


# 存储类型 local / oss
STORAGE_TYPE=local

# 本地存储配置
LOCAL_UPLOAD_BASE_DIR=uploads
LOCAL_STATIC_PREFIX=/uploads

# 阿里云OSS配置
OSS_REGION=oss-cn-xxx
OSS_ACCESS_KEY_ID=你的key
OSS_ACCESS_KEY_SECRET=你的secret
OSS_BUCKET=bucket名称
OSS_CDN_DOMAIN=https://xxx.oss-cn-xxx.aliyuncs.com
OSS_UPLOAD_FOLDER=upload


# ========== 模型选择 openai / local_ollama / dashscope_qwen
#LLM_TYPE=dashscope_qwen
LLM_TYPE=dashscope_qwen

# OpenAI 配置
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Ollama 本地模型（需本地启动ollama）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# 阿里云 DashScope 通义千问（OpenAI兼容格式）
DASHSCOPE_API_KEY=sk-ws-H.EIXLMEE.1RZM.MEYCIQDXJ2iRcR929k4_9MEgM8VqT6oQc4lGebqzuDqAN3b7MwIhAMAOTNxVZ7LwMK7Rdjaz9_AfRnHNFJuoXrP5S4RqcWVd
DASHSCOPE_MODEL=qwen-plus

# Redis 会话存储
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=liwei

# CORS 跨域白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:5175
